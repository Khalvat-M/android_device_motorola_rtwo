<!-- MCI (MCC 432 / MNC 11). Keys here are MERGED into the Motorola entry:
     same key -> our value wins, other Motorola keys are kept. -->
<carrier_config mcc="432" mnc="11">
    <!-- VoLTE -->
    <boolean name="carrier_volte_available_bool" value="true" />
    <boolean name="enhanced_4g_lte_on_by_default_bool" value="true" />
    <boolean name="carrier_volte_provisioning_required_bool" value="false" />
    <!-- ViLTE (video calling) -->
    <boolean name="carrier_vt_available_bool" value="true" />
    <boolean name="ignore_data_enabled_changed_for_video_calls" value="true" />
    <boolean name="vilte_data_is_metered_bool" value="false" />
    <!-- VoWiFi: mode 0=wifi only, 1=cellular preferred, 2=wifi preferred -->
    <boolean name="carrier_wfc_ims_available_bool" value="true" />
    <boolean name="carrier_default_wfc_ims_enabled_bool" value="false" />
    <int name="carrier_default_wfc_ims_mode_int" value="1" />
    <boolean name="carrier_default_wfc_ims_roaming_enabled_bool" value="false" />
    <int name="carrier_default_wfc_ims_roaming_mode_int" value="1" />
    <boolean name="editable_wfc_mode_bool" value="true" />
    <boolean name="editable_wfc_roaming_mode_bool" value="true" />
    <!-- VoNR / Vo5G: 1 = NSA, 2 = SA -->
    <int-array name="carrier_nr_availabilities_int_array" num="2">
        <item value="1" />
        <item value="2" />
    </int-array>
    <boolean name="vonr_enabled_bool" value="true" />
    <boolean name="vonr_on_by_default_bool" value="true" />
    <boolean name="vonr_setting_visibility_bool" value="true" />
    <!-- Supplementary services over UT: forwarding, waiting, caller ID, barring -->
    <boolean name="carrier_supports_ss_over_ut_bool" value="true" />
    <boolean name="call_forwarding_visibility_bool" value="true" />
    <boolean name="additional_settings_call_waiting_visibility_bool" value="true" />
    <boolean name="additional_settings_caller_id_visibility_bool" value="true" />
    <boolean name="call_barring_visibility_bool" value="true" />
    <boolean name="call_barring_supports_password_change_bool" value="true" />
    <boolean name="call_barring_supports_deactivate_all_bool" value="true" />
</carrier_config>
